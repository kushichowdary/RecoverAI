# ==============================================================================
# RecoverAI — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to '.env' and fill in credentials for local development.
# Do NOT commit actual secrets or credentials to source control.

# Database URL
# Defaults to a local SQLite database file in the project directory.
DATABASE_URL=sqlite:///./recoverai.db

# Allowed CORS Origins
# Comma-separated list of origins. If empty, defaults to local Vite/React development dev servers.
# In production, same-origin calls are used, so this can remain empty.
FRONTEND_ORIGIN=

# AI Provider Configuration
# Set to "mock" for local/mock validation (no API calls, deterministic evaluation).
# Set to "anthropic" for live Claude reasoning engine (requires ANTHROPIC_API_KEY).
AI_PROVIDER=mock
ANTHROPIC_API_KEY=

# Razorpay Integration Mode
# Set to "mock" to run the local mock payment gateway adapter (always available).
# Set to "test" to run using server-side Basic Auth against Razorpay's Test Endpoint (requires credentials below).
RAZORPAY_MODE=mock

# Razorpay Test Mode Credentials
# Never expose these credentials to frontend React/browser code.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Production server port (Render / PaaS automatically sets this)
PORT=8000
